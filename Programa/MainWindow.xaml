        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="0*"/>
        </Grid.ColumnDefinitions>
        <Label Content="Usuário" HorizontalAlignment="Left" Margin="314,139,0,0" VerticalAlignment="Top" Width="159" Foreground="Black"/>
        <Label Content="Senha" HorizontalAlignment="Left" Margin="314,211,0,0" VerticalAlignment="Top" Width="159"/>
        <Button Content="Entrar" HorizontalAlignment="Center" Margin="0,286,0,0" VerticalAlignment="Top" Width="80" Click="Button_Click"/>
        <PasswordBox HorizontalAlignment="Left" Margin="320,237,0,0" VerticalAlignment="Top" Width="153" Background="White" SelectionBrush="#FF4096DA" Foreground="Black"/>
        <TextBox HorizontalAlignment="Left" Margin="320,170,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="153"/>

    </Grid>
</Window>
