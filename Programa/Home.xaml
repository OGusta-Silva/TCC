<Window x:Class="WpfApp1.Home"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Home" Height="500" Width="800" WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="5 0 5">
            <Label Grid.Column="0" Content="Nome" HorizontalAlignment="Right"/>
            <Label Grid.Column="0" Content="Placa" HorizontalAlignment="Right"/>
            <Label Grid.Column="0" Content="Nome" HorizontalAlignment="Right"/>
            <Label Grid.Column="0" Content="Data" HorizontalAlignment="Right"/>
            <Label Grid.Column="0" Content="Velocidade" HorizontalAlignment="Right"/>
            <Label Grid.Column="0" Content="Limite Velocidade" HorizontalAlignment="Right"/>
           
        </StackPanel>
        
        <StackPanel Grid.Column="1" Margin =" 2 5 2 5">
            <TextBlock />

        </StackPanel>
        
        
    </Grid>
</Window>
