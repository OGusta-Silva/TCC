<Window x:Class="WpfApp1.Home"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Home" Height="500" Width="800" WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
            <Menu>
                <MenuItem  Header="Inicio">
                    
                </MenuItem>
                 
            </Menu>
            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Cadastro Infração" FontSize="25" Background="White" FlowDirection="RightToLeft" HorizontalAlignment="Left" Foreground="Black" Padding="10"/>

        </StackPanel>
        

        <StackPanel Grid.Row="1" Grid.Column="0" Margin="5 5">
            <Label Grid.Column="0" Content="Nome" HorizontalAlignment="Right" Margin="0 7 0 0"/>
            <Label Grid.Column="0" Content="Placa" HorizontalAlignment="Right" Margin="0 7 0 0"/>
            <Label Grid.Column="0" Content="Número Rastreador" HorizontalAlignment="Right" Margin="0 7 0 0"/>
            <Label Grid.Column="0" Content="Data" HorizontalAlignment="Right" Margin="0 7 0 0"/>
            <Label Grid.Column="0" Content="Velocidade" HorizontalAlignment="Right" Margin="0 7 0 0"/>
            <Label Grid.Column="0" Content="Limite Velocidade" HorizontalAlignment="Right" Margin="0 7 0 0"/>
           
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="1" Margin =" 2 5 2 5" >
            <TextBox x:Name="txtBoxNome" Height="25" Margin="0 5 0 0" Foreground="Black" SelectionTextBrush="Black"/>
            <TextBox x:Name="txtBoxPlaca" Height="25" Margin="0 5 0 0"/>
            <TextBox x:Name="txtBoxnumero" Height="25" Margin="0 5 0 0"/>
            <TextBox x:Name="txtBoxData" Height="25" Margin="0 5 0 0"/>
            <TextBox x:Name="txtBoxVelocidade" Height="25" Margin="0 5 0 0"/>
            <TextBox x:Name="txtBoxLimiteVelocidade" Height="25" Margin="0 5 0 0"/>
            <Button x:Name="BtnSalvar" Foreground="White" Background="#FF1F5C91" BorderBrush="White" Content="Salvar" Margin="5" Click="BtnSalvar_Click"/>
        </StackPanel>
       
        
    </Grid>
</Window>
