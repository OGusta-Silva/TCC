<Window x:Class="WpfApp1.Home"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" 
        Title="Cadastro de Infração"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="White" av:DesignWidth="774">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Menu e título -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="0" Grid.ColumnSpan="2">

            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
            <Button x:Name="Voltar" Width="49" Margin="0 0 10 0" Height="28" BorderThickness="0" RenderTransformOrigin="0.5,0.5" Background="White" Click="Voltar_Click" >
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform AngleY="1.056"/>
                        <RotateTransform Angle="-0.913"/>
                        <TranslateTransform Y="0.276"/>
                    </TransformGroup>
                </Button.RenderTransform>
                <StackPanel>
                    <Image Source="/Imagens/icons8-voltar-48.png" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                            />
                    <TextBlock><Run Text="Voltar"/></TextBlock>
                </StackPanel>
            </Button>
            <TextBlock Text="Cadastro Infração"
                   FontSize="17"
                   Background="White"
                   Foreground="Black"
                   Padding="10"
                   Height="48"
                   TextAlignment="Center" Width="144"/>
        </StackPanel>

        <!-- Formulário -->
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Labels -->
            <Label Grid.Row="0" Grid.Column="0" Content="Nome" VerticalAlignment="Center" Margin="0,5"/>
            <Label Grid.Row="1" Grid.Column="0" Content="Placa" VerticalAlignment="Center" Margin="0,5"/>
            <Label Grid.Row="2" Grid.Column="0" Content="Número Rastreador" VerticalAlignment="Center" Margin="0,5"/>
            <Label Grid.Row="3" Grid.Column="0" Content="Data" VerticalAlignment="Center" Margin="0,5"/>
            <Label Grid.Row="4" Grid.Column="0" Content="Velocidade" VerticalAlignment="Center" Margin="0,5"/>
            <Label Grid.Row="5" Grid.Column="0" Content="Limite Velocidade" VerticalAlignment="Center" Margin="0,5"/>

            <!-- Campos -->
            <TextBox x:Name="txtBoxNome" Grid.Row="0" Grid.Column="1" Height="25" Margin="5"/>
            <TextBox x:Name="txtBoxPlaca" Grid.Row="1" Grid.Column="1" Height="25" Margin="5"/>
            <TextBox x:Name="tBoxnumero" Grid.Row="2" Grid.Column="1" Height="25" Margin="5"/>
            <TextBox x:Name="txtBoxData" Grid.Row="3" Grid.Column="1" Height="25" Margin="0,5,10,4"/>
            <TextBox x:Name="txtBoxVelocidade" Grid.Row="4" Grid.Column="1" Height="25" Margin="5"/>
            <TextBox x:Name="txtBoxLimiteVelocidade" Grid.Row="5" Grid.Column="1" Height="25" Margin="5"/>


            <!-- Botão -->

            <Button x:Name="BtnSalvar"
                Grid.Row="6" Grid.Column="1"
                Content="Salvar"
                Width="100"
                Margin="5,20,0,0"
                HorizontalAlignment="Left"
                Click="BtnSalvar_Click"/>

            <StackPanel/>

        </Grid>


    </Grid>

</Window>
