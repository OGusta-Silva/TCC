<Window x:Class="WpfApp1.Views.Relatorio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="Relatório de Infrações" Height="800" Width="1100" WindowStartupLocation="CenterScreen">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="74"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Height="54" Width="382">
            <Button Width="40" Height="29" Margin="10" Background="White" BorderBrush="Transparent" Click="Voltar_Click">
               <Image Source="/Imagens/icons8-voltar-48.png" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>
            <TextBlock Text="Relatório de Infrações"
                       Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                       Padding="10" Height="62" Foreground="Black" Width="337" Background="White"/>
        </StackPanel>

        <!-- Filtro por período -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,10" VerticalAlignment="Center">
            <TextBlock Text="De:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker x:Name="dtFiltroInicio" Width="130" Margin="0,0,15,0"/>
            <TextBlock Text="Até:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker x:Name="dtFiltroFim" Width="130" Margin="0,0,15,0"/>
            <Button Content="Gerar Relatório" Click="BtnGerar_Click" Width="130" Margin="0,0,5,0"/>
            <Button x:Name="BtnExportarPdf" Content="Exportar PDF" Click="BtnExportarPdf_Click" Width="110" IsEnabled="False"/>
        </StackPanel>

        <TextBlock Grid.Row="2" x:Name="txtInfoResultado"
                    Text="Escolha um período e clique em &quot;Gerar Relatório&quot;."
                    Margin="10,0,10,10" FontStyle="Italic" Foreground="Gray"/>

        <DataGrid Grid.Row="3" Margin="5,0,5,5" x:Name="dataGridRelatorio" IsReadOnly="True"
                  AutoGenerateColumns="False" AlternatingRowBackground="#FFE5E5E5" AlternationCount="2">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}"/>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}"/>
                <DataGridTextColumn Header="Placa Veiculo" Binding="{Binding Placa}"/>
                <DataGridTextColumn Header="Numero Rastreador" Binding="{Binding numRastreador}"/>
                <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=dd/MM/yyyy}"/>
                <DataGridTextColumn Header="Velocidade" Binding="{Binding Velocidade}"/>
                <DataGridTextColumn Header="Limite Velocidade" Binding="{Binding Limitevelocidade}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
